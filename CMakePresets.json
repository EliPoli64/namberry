{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "standalone",
      "displayName": "Standalone (Release)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-standalone"
    },
    {
      "name": "vst3",
      "displayName": "VST3 (Release)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-vst3"
    },
    {
      "name": "debug",
      "displayName": "Standalone + VST3 (Debug)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "standalone",
      "displayName": "Build Standalone",
      "configurePreset": "standalone",
      "targets": ["NAMBerry_Standalone"]
    },
    {
      "name": "vst3",
      "displayName": "Build VST3",
      "configurePreset": "vst3",
      "targets": ["NAMBerry_VST3"]
    },
    {
      "name": "debug",
      "displayName": "Build Standalone + VST3 (Debug)",
      "configurePreset": "debug",
      "targets": ["NAMBerry_Standalone", "NAMBerry_VST3"]
    }
  ]
}
